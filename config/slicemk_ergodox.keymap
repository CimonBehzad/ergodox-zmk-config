/*
 * ZSA Oryx layout converted to ZMK for the SliceMK ErgoDox Wireless (dongle).
 * The host OS keyboard layout is assumed to be Swedish, as in the original.
 * Key codes are positional, so every key sends the same physical key as before.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define SYMB  1
#define MOUSE 2
#define NAV   3

/ {
	keymap {
		compatible = "zmk,keymap";

		layer_0 {
			display-name = "base";
			bindings = <
				&bootloader
				&kp ESC        &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp LC(X)       &kp DEL     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
				&kp TAB        &kp Q     &kp W     &kp E     &kp R     &kp T     &kp LC(Z)       &kp LC(Y)   &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT
				&kp LC(LSHFT)  &kp A     &kp S     &kp D     &kp F     &kp G                                 &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
				&kp LSHFT      &kp Z     &kp X     &kp C     &kp V     &kp B     &kp LC(C)       &kp LC(V)   &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT
				&kp LCTRL      &none     &kp RALT  &kp NUBS  &kp BSLH                                                  &kp RBKT  &kp EQUAL &kp LALT  &kp LGUI  &kp RCTRL
				                                                       &kp LA(SPACE) &mo MOUSE   &tog MOUSE  &kp PLUS
				                                           &kp S       &kp BSPC      &mo SYMB    &mo SYMB    &kp RET   &kp SPACE
				                                                                     &mo NAV     &mo NAV
			>;
		};

		layer_1 {
			display-name = "symb";
			bindings = <
				&bootloader
				&kp ESC    &kp LS(GRAVE) &kp RA(N2) &kp RA(RBKT) &kp GRAVE &kp RA(N5) &kp GRAVE    &kp RA(N4) &kp RA(MINUS) &kp RA(N7) &kp RA(N8) &kp RA(N9) &kp RA(N0) &kp RA(N3)
				&kp NUBS   &trans        &trans     &trans       &trans    &trans     &trans       &trans     &trans        &kp RA(M)  &trans     &trans     &trans     &kp LS(NUBS)
				&trans     &trans        &trans     &trans       &trans    &trans                             &trans        &trans     &trans     &trans     &trans     &trans
				&trans     &trans        &trans     &trans       &trans    &trans     &trans       &trans     &trans        &trans     &trans     &trans     &trans     &trans
				&trans     &trans        &trans     &trans       &trans                                                     &trans     &trans     &trans     &trans     &trans
				                                                           &trans     &trans       &trans     &trans
				                                                 &trans    &trans     &trans       &trans     &trans        &trans
				                                                                      &trans       &trans
			>;
		};

		layer_2 {
			display-name = "mouse";
			bindings = <
				&bootloader
				&kp ESC  &kp F1  &kp F2          &kp F3          &kp F4           &kp F5          &trans     &trans  &kp F6     &kp F7      &kp F8     &kp F9     &kp F10 &trans
				&trans   &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_UP    &trans     &trans  &mkp LCLK  &mkp RCLK   &kp F11    &kp F12    &trans  &trans
				&trans   &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                     &trans     &trans      &trans     &trans     &trans  &trans
				&trans   &trans  &trans          &trans          &trans           &trans          &trans     &trans  &kp C_PP   &kp PAUSE_BREAK &kp C_PREV &kp C_NEXT &trans &trans
				&trans   &trans  &trans          &trans          &trans                                                         &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &trans &trans
				                                                                  &trans          &trans     &trans  &trans
				                                                 &trans           &trans          &trans     &trans  &trans     &kp C_AC_BACK
				                                                                                  &trans     &trans
			>;
		};

		layer_3 {
			display-name = "nav";
			bindings = <
				&bootloader
				&trans &trans &trans &trans           &trans             &trans            &trans    &trans &trans        &kp LG(UP)   &trans        &trans &trans &none
				&trans &trans &trans &trans           &trans             &trans            &trans    &trans &kp LG(LEFT)  &kp LG(DOWN) &kp LG(RIGHT) &trans &trans &none
				&trans &trans &trans &trans           &kp LG(TAB)        &trans                             &trans        &kp UP       &trans        &trans &trans &none
				&trans &trans &trans &kp LG(LC(LEFT)) &kp LA(LC(SPACE))  &kp LG(LC(RIGHT)) &trans    &trans &kp LEFT      &kp DOWN     &kp RIGHT     &trans &trans &trans
				&trans &trans &trans &trans           &trans                                                              &trans       &trans        &trans &trans &trans
				                                                         &trans            &trans    &trans &trans
				                                      &trans             &trans            &trans    &trans &trans        &trans
				                                                                           &trans    &trans
			>;
		};
	};
};
